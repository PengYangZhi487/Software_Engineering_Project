    "dark": {
      "bg": "#0B0C0E",
      "surface": "#121316",
      "surface-2": "#17181C",
      "line": "#232529",
      "line-strong": "#33363D",
      "text": "#EDEDEF",
      "text-2": "#A2A4AB",
      "text-3": "#71747C",
      "accent": "#8B85FF",
      "accent-hover": "#A6A1FF",

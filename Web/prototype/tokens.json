  },
  "glass": {
    "backdrop": "blur(26px) saturate(185%)",
    "panel-sheen": "linear-gradient(180deg, rgba(255,255,255,.18), rgba(255,255,255,.02) 55%, transparent)",
    "edge": "1px solid rgba(255,255,255,.74)",
    "inner-highlight": "inset 0 1px 0 rgba(255,255,255,.85)",
    "popover": "实色 #FCFAFF（菜单不做透明，保证可读）",
    "background": [
      "radial 46% 44% at 22% 6%  rgba(147,112,246,.50)",
      "radial 40% 42% at 82% 22% rgba(108,124,246,.34)",
      "radial 44% 46% at 96% 92% rgba(232,140,250,.32)",
      "radial 46% 44% at 6% 82%  rgba(176,156,250,.44)",
      "linear 122deg violet → transparent → pink → indigo",
      "base linear-gradient(160deg, #EFE7FC, #F7F1FE 55%, #F2E9FC)"
    ]
  },
  "radius": {
    "lg": "12px",
    "md": "9px",
    "sm": "6px",
    "pill": "999px"
  },
  "space": ["4px", "8px", "12px", "16px", "20px", "24px", "32px"],
  "layout": {
    "sidebar": "244px",
    "topbar": "56px",
    "content-padding": "22px 26px 44px",
    "drawer": "428px",
    "doc-pane": "216px / 1fr / 336px"
  },
  "type": {
    "font-sans": "Inter, -apple-system, 'Segoe UI Variable Text', 'Segoe UI', 'PingFang SC', 'HarmonyOS Sans SC', 'Microsoft YaHei UI', sans-serif",
    "font-mono": "'SF Mono', 'Cascadia Mono', 'JetBrains Mono', Consolas, monospace",
    "size": {
      "page-title": "21px/650",
      "section-title": "12.5px/600",
      "label": "10.5px/600 + 0.06em",
      "body": "13px/400",
      "table": "12.5px/400",
      "metric": "27px/600",
      "mono-meta": "10px/400"
    }
  },
  "motion": {
    "fast": "140ms",
    "base": "220ms",
    "ease": "cubic-bezier(.2, .8, .2, 1)",
    "enter": "opacity 0→1 + translateY(6px)",
    "rule": "只动 opacity / transform，不做布局动画"
  },
  "elevation": {
    "card": "none（仅 1px hairline；glass 主题加 0 24px 56px -38px 柔和外阴影）",
    "popover": "0 24px 56px -28px rgba(15,17,21,.30), 0 2px 8px -2px rgba(15,17,21,.06)"
  }
}

{
  "meta": {
    "name": "RATGP Design Tokens",
    "version": "P0.1 / 2026-11-09",
    "note": "三个主题共用一套语义变量：light / glass / dark。预览页里的 CSS 变量与此文件一一对应，P1 时映射到 Tailwind theme。"
  },
  "color": {
    "light": {
      "bg": "#F6F6F3",
      "surface": "#FFFFFF",
      "surface-2": "#FAFAF8",
      "line": "#E8E6E1",
      "line-strong": "#D8D5CE",
      "text": "#16181B",
      "text-2": "#5C5F66",
      "text-3": "#8F9298",
      "accent": "#4F46E5",
      "accent-hover": "#4338CA",
      "accent-soft": "#EEECFE",
      "accent-line": "#DBD8FC",
      "ok": "#0E7C57",
      "ok-soft": "#E7F6EF",
      "warn": "#B45309",
      "warn-soft": "#FCF1E2",
      "danger": "#BE123C",
      "danger-soft": "#FDECEF"
    },
    "glass": {
      "bg": "#F1ECFB",
      "surface": "rgba(255,255,255,.40)",
      "surface-2": "rgba(255,255,255,.24)",
      "line": "rgba(108,94,168,.15)",
      "line-strong": "rgba(108,94,168,.28)",
      "text": "#241F38",
      "text-2": "#57506F",
      "text-3": "#8A83A2",
      "accent": "#5B4BD6",
      "accent-hover": "#4B3BC4",
      "accent-soft": "rgba(91,75,214,.12)",
      "accent-line": "rgba(91,75,214,.26)",
      "ok": "#0C7350",
      "ok-soft": "rgba(16,185,129,.12)",
      "warn": "#A9610A",
      "warn-soft": "rgba(245,158,11,.14)",
      "danger": "#AF1B44",
      "danger-soft": "rgba(244,63,94,.12)",
      "glass-border": "rgba(255,255,255,.74)",
      "glass-blur": "26px"
